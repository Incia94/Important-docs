# Basic GIT Commands

git init <directory>    ---  Initialize a New Local repository . Directory is optional

git config --global user.name "incia"     ---  To set Author Name during Commits

git config --global user.email incia.anand@gmail.com    --- To set Author Email during Commits. Keep Same as Github Email

git clone <URL>    --- To Clone a remote repository

git checkout -b branchname-incia  --- creates a new branch

git checkout branchname-anand     --- go to that branch

git branch                        --- see all branches

git checkout -d branchname-incia / git checkout -D branchname-incia  --- delete the branch

git add *   --- Add all files in the directory

git add /path/to/filename  --- Add a particular file for commit to local repository

git commit -m "<message>"  --- Commit Changes to local repo

git commit -a -m "<message>"

# or

git commit -am "<message>"                   --- Add all changes made to tracked files & commit

git commit --sign-off "incia.anand@emc.com"  --- Commit by using the sign-off

git push origin master        --- push changes to the master of own remote repo

git status  --- check status of all commits happened and to be done

git diff    --- show difference between commits, commit & directory we are working in

git diff --staged   ---- Use the --staged flag to display the changes to staged files.

git diff <commit id 01> <commit id 02>   --- Displays changes between two commits

git diff branch1..branch2       ---- Diff between two branches

git log --- to see version history of current branch

git grep "func()"  -- search for func() in the woring directory

git pull --- merges change in master on own repo (working directory)

git reset <commit ID>  --- undoes all the commits after the specified commit and preserves the changes locally.

git reset -hard <commit ID>  ---discards all history and goes back to the specified commit.

git reset <file>     ---- Remove a file from the staging area.

git revert <COMMIT-ID>     ---- Revert a commit. - undo commit

git merge branchname-incia  --- merge the branch into current HEAD
--no-ff: Create a merge commit even if the merge resolves as a fast-forward
--squash: Squash all commits from the specified branch into a single commit

git rm filename   -- to remove the file from working directory

git rm --cached <file>  --- remove it from staging area only using --cached flag

git mv <current path> <new path>   --- Move or Rename a file

git stash     ---  Stash allows you to temporarily store changes without committing them.

git stash save "<message>"   --- To add a message to the stash.

git stash list     --- List all stashes

git stash apply <stash id>    --- Apply the Stash qwith Stash ID

git stash drop <stash id>   --- Remove from stash

git stash clear             --- Remove all stashes

git stash pop <stash id>    ---- Apply and remove a stash ID

git stash show <stash id>   ---- Display the changes in the Stash ID

git remote add <remote name> <url>    ---- Add a remote repository

git remote     ---- Display remote repositories

git remote -v  --- Display remote repositories with URLs

git remote remove <remote name>   --- Remove a Remote Repo

git remote rename <old name> <new name>  --- Rename a Remote Repo

git fetch <remote name>  --- Fetch changes from a remote repository

git fetch <remote name> <branch>  ---- Fetch changes from a particular branch

git pull <remote name> <branch>   ---- Pull changes from a remote repository

git pull <remote name>  ---- Push changes to a remote repository

git pull <remote name> <branch>  ---- Push changes to a remote repository for a particular branch 
